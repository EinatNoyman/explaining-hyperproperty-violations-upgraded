-- NuSMV twin of triple_forall.aag, generated by tools/aag2smv.py.
-- DO NOT EDIT BY HAND: regenerate instead, so that the two
-- encodings cannot drift apart. Equivalence to the .aag is
-- checked exhaustively by `aag2smv.py --verify`.
--
-- AND gates are inlined, so this model exposes exactly the
-- signals the AIGER exposes: no internal gate names leak in.
--
-- A free input is written as a nondeterministic assignment:
-- in NuSMV, nondeterministic choice IS an input. AutoHyper
-- requires {TRUE, FALSE} for a boolean, not {0,1}.
--
-- inputs : x
-- latches: state
MODULE main
VAR
  state : boolean;
  x : boolean;
ASSIGN
  init(state) := FALSE;
  next(state) := x;

  init(x) := {TRUE, FALSE};
  next(x) := {TRUE, FALSE};
DEFINE
  out := state;
