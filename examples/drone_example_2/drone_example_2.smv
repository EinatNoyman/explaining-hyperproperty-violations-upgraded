  init(state0) := FALSE;
  next(state0) := (!((!((!state1) & (!state0))) & bound));
  init(state1) := FALSE;
  next(state1) := ((!((!bound) & (!up))) & (!((!state1) & (!state0))));

  init(up) := {TRUE, FALSE};
  next(up) := {TRUE, FALSE};
  init(bound) := {TRUE, FALSE};
  next(bound) := {TRUE, FALSE};
DEFINE
