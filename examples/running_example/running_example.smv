  state0 : boolean;
  state1 : boolean;
  hi : boolean;
ASSIGN
  init(state0) := FALSE;
  next(state0) := (!((!((!(state1 & (!state0))) & (!((!state1) & (!state0))))) & ((!(state1 & (!state0))) & (!(((!state1) & (!state0)) & hi)))));
  init(state1) := FALSE;
  next(state1) := (!(((!((state1 & (!state0)) & (!hi))) & (!(((!state1) & (!state0)) & (!hi)))) & (!((!(state1 & (!state0))) & (!((!state1) & (!state0)))))));

  init(hi) := {TRUE, FALSE};
  next(hi) := {TRUE, FALSE};
DEFINE
